#: src/Plugin.php:188
msgid "Cookies kunnen niet veilig worden gezet. Sluit de aanmeldpagina uit van caching."
msgstr "Cookies cannot be set securely. Exclude the sign-up page from caching."

#: src/Admin.php:624 src/Frontend.php:397
msgid "Datum"
msgstr "Date"

#: src/Admin.php:653
msgid "Datum / fout"
msgstr "Date / error"

